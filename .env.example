# API 配置
API_KEY=testapi
BASE_URL=https://api.longcat.chat/openai/v1
MODEL=Longcat-2.0

# Embedding 配置
EMB_API_KEY=
EMB_BASE_URL=
EMB_MODEL=text-embedding-3-small

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=paper_rag

# 存储路径
STORAGE_DIR=./storage_data
SQLITE_PATH=./storage_data/metadata.db
BM25_INDEX_PATH=./storage_data/bm25_index.json

# 分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索配置
RETRIEVE_TOP_K=10
BM25_TOP_K=10
VECTOR_TOP_K=10
RERANK_TOP_K=5
RRF_K=60

# 重排序配置
RERANK_MODEL=bge-reranker-v2-m3
USE_RERANK=true

# 应用配置
INPUT_DIR=./input/papers
OUTPUT_DIR=./output
EVALUATION_TOPIC=AI赋能
LOG_LEVEL=INFO
